<Project>

  <PropertyGroup>
    <!-- Commit packages.lock.json so the whole transitive graph is visible to
         GitHub's dependency graph. Without a lockfile it only sees direct
         PackageReference entries, which is why two critical (CVSS 9.8)
         transitive advisories went unreported here.

         Excluded for WorkerExtensions: the Azure Functions SDK generates that
         project into obj/ at build time, and it inherits this file. It has no
         checked-in lockfile to validate against, so requiring one there only
         risks breaking the build. -->
    <RestorePackagesWithLockFile Condition="'$(MSBuildProjectName)' != 'WorkerExtensions'">true</RestorePackagesWithLockFile>

    <!-- Also surface transitive advisories at restore time. Warnings, not
         errors: no project here sets TreatWarningsAsErrors globally. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

</Project>
